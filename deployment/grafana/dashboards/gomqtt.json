{
  "uid": "gomqtt-overview",
  "title": "GoMQTT Overview",
  "description": "Connections, message flow, QoS mix and delivery health for the GoMQTT broker.",
  "tags": ["gomqtt", "mqtt", "broker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service level",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connected clients",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "refId": "A", "expr": "gomqtt_connected_clients", "legendFormat": "clients" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Delivery throughput",
      "description": "Deliveries to subscribers per second. One publish to fifty subscribers counts fifty.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gomqtt_messages_delivered_total[1m]))",
          "legendFormat": "msg/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p99 fan-out latency",
      "description": "Time from accepting a publish to handing it to every matching subscriber's writer.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(gomqtt_delivery_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dropped messages",
      "description": "Messages the broker could not deliver. A steady non-zero rate means at least one client is persistently slower than its traffic.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 15, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gomqtt_messages_dropped_total[1m]))",
          "legendFormat": "dropped/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "In-flight QoS 1",
      "description": "Unacknowledged QoS 1 messages across all sessions. Climbing means subscribers are not keeping up with their acknowledgements.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "yellow" }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        { "refId": "A", "expr": "gomqtt_inflight_messages", "legendFormat": "in flight" }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Message flow",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Published vs delivered",
      "description": "The gap between the two is the fan-out ratio: how many subscribers the average message reaches.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 12, "lineWidth": 2 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gomqtt_messages_published_total[1m]))",
          "legendFormat": "published"
        },
        {
          "refId": "B",
          "expr": "sum(rate(gomqtt_messages_delivered_total[1m]))",
          "legendFormat": "delivered"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Fan-out latency percentiles",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 8, "lineWidth": 2 }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(gomqtt_delivery_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(gomqtt_delivery_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(gomqtt_delivery_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Protocol",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Control packets received, by type",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 18, "lineWidth": 1, "stacking": { "mode": "normal" } },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (packet_type) (rate(gomqtt_packets_received_total[1m]))",
          "legendFormat": "{{packet_type}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Deliveries by QoS, and retransmissions",
      "description": "Retransmissions rising against a flat delivery rate means acknowledgements are being lost or delayed.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 12, "lineWidth": 2 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (qos) (rate(gomqtt_messages_delivered_total[1m]))",
          "legendFormat": "qos {{qos}}"
        },
        {
          "refId": "B",
          "expr": "rate(gomqtt_retransmissions_total[1m])",
          "legendFormat": "retransmissions"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Connections and state",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Connections and disconnections",
      "description": "A steady stream of keep_alive_timeout or network_error disconnects points at an unhealthy fleet rather than an unhealthy broker.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 12, "lineWidth": 2 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(gomqtt_connections_total[1m])",
          "legendFormat": "connects"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(gomqtt_disconnections_total[1m]))",
          "legendFormat": "disconnect: {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum by (reason) (rate(gomqtt_connections_rejected_total[1m]))",
          "legendFormat": "rejected: {{reason}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Broker state",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 8, "lineWidth": 2 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "gomqtt_sessions", "legendFormat": "sessions" },
        { "refId": "B", "expr": "gomqtt_subscriptions", "legendFormat": "subscriptions" },
        { "refId": "C", "expr": "gomqtt_retained_messages", "legendFormat": "retained topics" },
        { "refId": "D", "expr": "gomqtt_connected_clients", "legendFormat": "connected clients" }
      ]
    }
  ],
  "__inputs": [],
  "__requires": []
}
